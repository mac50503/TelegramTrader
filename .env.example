# Application
NODE_ENV=development
LOG_LEVEL=info

# Telegram MTProto (obtain API ID/hash from https://my.telegram.org/apps)
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram/session
# Comma-separated numeric chat/channel IDs. Empty means accept none.
TELEGRAM_ALLOWED_CHATS=

# AI CLI. Message JSON is sent through stdin; never interpolated into the command.
# Leave AI_AGENT_COMMAND empty to auto-detect an agent CLI from AI_PROVIDERS instead.
AI_AGENT_ENABLED=false
AI_AGENT_COMMAND=
AI_AGENT_ARGS_JSON=[]
AI_AGENT_TIMEOUT_MS=45000
AI_AGENT_MAX_OUTPUT_BYTES=65536
AI_MIN_CONFIDENCE=0.70
# Deterministic keyword/number pre-check that skips the AI CLI call for obvious non-signals.
AI_PREFILTER_ENABLED=true

# Agent CLI auto-detection (only used when AI_AGENT_COMMAND is empty). Tried in order;
# the first one that responds to `<command> --version` is used for the life of the process.
AI_PROVIDERS=claude,codex,kiro-cli
AI_PROVIDER_DETECT_TIMEOUT_MS=5000
# claude is the only provider with verified tool-isolation (--tools "") for this pipeline.
# Cheap model for a simple classification task; leave empty to use claude's own default.
AI_CLAUDE_MODEL=haiku
# codex invocation verified against official docs: `codex exec --sandbox read-only --ask-for-approval never`.
AI_CODEX_MODEL=
# SECURITY: keep "read-only" for this pipeline — it classifies untrusted Telegram text and must
# never be allowed to write files or run commands. Do not change to workspace-write/danger-full-access here.
AI_CODEX_SANDBOX=read-only
AI_CODEX_EXTRA_ARGS_JSON=[]
# kiro-cli invocation verified against a real reference project. Prompt goes through a temp file.
AI_KIRO_MODEL=claude-haiku-4.5
AI_KIRO_TIMEOUT_MS=120000
# SECURITY: grants kiro-cli full tool access (Bash, files, ...). Kept false because this pipeline
# processes untrusted Telegram text and the analyzer must never be able to execute anything.
# kiro-cli may hang/time out without it — that is the accepted trade-off. Enable only if you
# understand and accept the risk.
AI_KIRO_TRUST_ALL_TOOLS=false
AI_KIRO_EXTRA_ARGS_JSON=[]

# SQLite
DATABASE_URL=./data/telegram-trader.sqlite

# REST API
API_HOST=127.0.0.1
API_PORT=3000
API_KEY=change-me-to-a-long-random-secret
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Signal policy
SIGNAL_TTL_SECONDS=900
DUPLICATE_WINDOW_SECONDS=3600
DEFAULT_FIXED_LOT=0.01
DEFAULT_RISK_PERCENT=1

# Risk limits
MAX_LOT=1
MAX_RISK_PERCENT=2
MAX_DAILY_TRADES=5
# Realized loss in the MT5 account deposit currency.
MAX_DAILY_LOSS=500
MAX_SIMULTANEOUS_TRADES=1
MT5_CONTEXT_MAX_AGE_SECONDS=300

# Trading safety: LIVE also requires LIVE_TRADING_CONFIRM and EA opt-in.
TRADING_MODE=SIMULATION
LIVE_TRADING_CONFIRM=
MT5_ALLOWED_ACCOUNT_IDS=

# EA-side reference
MT5_API_URL=http://127.0.0.1:3000
