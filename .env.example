# Application
NODE_ENV=development
LOG_LEVEL=info

# Telegram MTProto (obtain API ID/hash from https://my.telegram.org/apps)
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram/session
# Comma-separated numeric chat/channel IDs. Empty means accept none.
TELEGRAM_ALLOWED_CHATS=

# AI CLI. Message JSON is sent through stdin; never interpolated into the command.
AI_AGENT_ENABLED=false
AI_AGENT_COMMAND=
AI_AGENT_ARGS_JSON=[]
AI_AGENT_TIMEOUT_MS=30000
AI_AGENT_MAX_OUTPUT_BYTES=65536
AI_MIN_CONFIDENCE=0.70

# SQLite
DATABASE_URL=./data/telegram-trader.sqlite

# REST API
API_HOST=127.0.0.1
API_PORT=3000
API_KEY=change-me-to-a-long-random-secret
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Signal policy
SIGNAL_TTL_SECONDS=900
DUPLICATE_WINDOW_SECONDS=3600
DEFAULT_FIXED_LOT=0.01
DEFAULT_RISK_PERCENT=1

# Risk limits
MAX_LOT=1
MAX_RISK_PERCENT=2
MAX_DAILY_TRADES=5
# Realized loss in the MT5 account deposit currency.
MAX_DAILY_LOSS=500
MAX_SIMULTANEOUS_TRADES=1
MT5_CONTEXT_MAX_AGE_SECONDS=300

# Trading safety: LIVE also requires LIVE_TRADING_CONFIRM and EA opt-in.
TRADING_MODE=SIMULATION
LIVE_TRADING_CONFIRM=
MT5_ALLOWED_ACCOUNT_IDS=

# EA-side reference
MT5_API_URL=http://127.0.0.1:3000
