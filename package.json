{
  "name": "telegram-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Telegram to MetaTrader 5 automated trading signal gateway",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/migrate.ts",
    "telegram:login": "tsx src/scripts/telegram-login.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@mtcute/node": "^0.31.0",
    "better-sqlite3": "^12.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
